# Copy this to `.env` on the Raspberry Pi next to `docker-compose.rpi.yml`.

# GitHub Container Registry owner or organization name.
GHCR_OWNER=

# NextAuth secret shared between the client and server for JWT verification.
NEXTAUTH_SECRET=

# Image tag to pull from GHCR.
IMAGE_TAG=latest

# Postgres settings for the Biomath Lab database container.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Comma-separated CORS origins for the FastAPI server.
# Keep the public frontend domain and any local dev origins you use.
CORS_ALLOW_ORIGINS=

# Optional: settings used by the publications-news container and cron jobs.
PUBMED_TOOL=biomath-publications-news
PUBMED_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
KINDLE_RECIPIENT=
KINDLE_SENDER=
PUBLICATIONS_NEWS_OUTPUT_DIR=/app/output
